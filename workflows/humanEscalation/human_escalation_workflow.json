{
  "name": "Human Escalation Workflow",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "customer_request"
            },
            {
              "name": "proposed_response"
            },
            {
              "name": "validation_reason"
            },
            {
              "name": "conversation_context"
            },
            {
